# FrontPad API — https://app.frontpad.ru/api/index.php?METHOD
# Секрет из настроек FrontPad → API. Без секрета заказы идут в stub-режим.
FRONTPAD_SECRET=

# Опционально: филиалы / точки продаж (ID из FrontPad)
FRONTPAD_AFFILIATE_CENTER=
FRONTPAD_AFFILIATE_HIPPODROME=
FRONTPAD_POINT_CENTER=
FRONTPAD_POINT_HIPPODROME=

# Канал продаж и теги (через запятую)
FRONTPAD_CHANNEL=
FRONTPAD_TAGS=

# Webhook статусов: публичный HTTPS URL сайта + коды статусов (через запятую, до 5)
# Пример: https://your-domain.ru/api/frontpad/webhook
FRONTPAD_HOOK_URL=
FRONTPAD_HOOK_STATUSES=

# 1 = передавать product_price[] вместе с заказом (иначе цены из FrontPad)
FRONTPAD_SEND_PRICES=0

# Notifications: choose one path
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

# Admin panel (/admin) — change in production
ADMIN_LOGIN=admin
ADMIN_PASSWORD=vechera2024
ADMIN_SESSION_SECRET=change-me-to-random-string
