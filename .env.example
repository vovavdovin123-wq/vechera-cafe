# ═══════════════════════════════════════════════════════════
# FrontPad API — https://app.frontpad.ru/api/index.php?METHOD
# Секрет: FrontPad → Настройки → Общие → API → «Секрет»
# Без секрета заказы идут в stub-режим (сайт работает, в FP не уходит).
# ═══════════════════════════════════════════════════════════
FRONTPAD_SECRET=

# Филиалы / точки продаж — «Код API» из справочников FrontPad
# (центр = center, ипподром = hippodrome на сайте)
FRONTPAD_AFFILIATE_CENTER=
FRONTPAD_AFFILIATE_HIPPODROME=
FRONTPAD_POINT_CENTER=
FRONTPAD_POINT_HIPPODROME=

# Канал продаж (справочник «Каналы продаж» → Код API) и теги через запятую
FRONTPAD_CHANNEL=
FRONTPAD_TAGS=

# Webhook статусов: публичный HTTPS URL + коды статусов (до 5, через запятую)
# Пример: https://vechera-cafe.ru/api/frontpad/webhook
FRONTPAD_HOOK_URL=https://vechera-cafe.ru/api/frontpad/webhook
FRONTPAD_HOOK_STATUSES=

# 1 = передавать product_price[] с сайта (нужна опция «Изменение цены» у товара в FP)
# 0 = цены берутся из FrontPad (рекомендуется)
FRONTPAD_SEND_PRICES=0

# Код варианта оплаты по умолчанию (справочник «Варианты оплаты»), опционально
FRONTPAD_DEFAULT_PAY=

# Notifications: choose one path
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

# Admin panel (/admin) — change in production
ADMIN_LOGIN=admin
ADMIN_PASSWORD=vechera2024
ADMIN_SESSION_SECRET=change-me-to-random-string
