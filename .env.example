# ═══════════════════════════════════════════════════════════
# FrontPad — ДВА аккаунта (центр и ипподром)
# Секрет: в каждом FrontPad → Настройки → Общие → API → «Секрет»
# Заказ с сайта уходит в аккаунт выбранной точки.
# ═══════════════════════════════════════════════════════════
FRONTPAD_SECRET_CENTER=
FRONTPAD_SECRET_HIPPODROME=

# Опционально: общий секрет (fallback, если не заданы секреты по точкам)
FRONTPAD_SECRET=

# Филиалы / точки внутри одного аккаунта (если всё же один FP) — обычно не нужны
# при двух отдельных аккаунтах
FRONTPAD_AFFILIATE_CENTER=
FRONTPAD_AFFILIATE_HIPPODROME=
FRONTPAD_POINT_CENTER=
FRONTPAD_POINT_HIPPODROME=

# Канал продаж и теги (через запятую) — общие, если одинаковые в обоих FP
FRONTPAD_CHANNEL=
FRONTPAD_TAGS=

# Webhook статусов — URL сайта (если пусто, подставится https://vechera-cafe.ru/api/frontpad/webhook)
FRONTPAD_HOOK_URL=https://vechera-cafe.ru/api/frontpad/webhook
# Коды из Справочники → Статусы → «Код API» (Вечера: 1,3,4,12,10,11)
# none = не передавать hook_status (только глобальный webhook в FP)
# Переименовать статус: FRONTPAD_STATUS_LABELS=3=В производстве,4=В пути
FRONTPAD_HOOK_STATUSES=1,3,4,12,10,11

# 1 = цены с сайта; 0 = цены из FrontPad
FRONTPAD_SEND_PRICES=0

FRONTPAD_DEFAULT_PAY=

# Yandex Geocoder (optional — without key, OpenStreetMap fallback is used)
YANDEX_GEOCODER_API_KEY=ba448d8a-154e-45e4-8fa3-8636214fc1db

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

# Admin panel (/admin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=vechera2024
ADMIN_SESSION_SECRET=change-me-to-random-string
